// Grafana Alloy — Linux variant (doc 16 §9-10, doc 14 §11.4-11.5).
//
// ⚠️ UNTESTED against a real Alloy binary or a real Grafana Cloud account (doc 16 §10's status
// table). Wired into `installer/linux/install-monitoring.sh` and wired into a real Ubuntu build
// 2026-09-08, which is what settled the log-source question §10 originally left open — see
// below.
//
// The Windows config (`config.alloy.template`) is the maintained sibling. Read its comments;
// they are not repeated here. Only what differs is explained in this file.
//
// WHAT DIFFERS FROM WINDOWS, and why — these three, and nothing else:
//
//   1. THE LOG SOURCE. On Windows, WinSW captures the service's stdout/stderr into rolling
//      files and Alloy tails them. This file originally offered two Linux alternatives here —
//      tail journald, or tail Docker's log driver — because no systemd unit existed yet to say
//      which applies. `installer/linux/buybox.service.template` (written 2026-09-08) settles
//      it: `StandardOutput=append:`/`StandardError=append:` write the same two plain files
//      WinSW does, rotated by `installer/linux/buybox.logrotate` instead of WinSW's
//      `roll-by-size-time` (doc 14 §11.4). That was the deliberate choice — file-based capture
//      is what the existing retention story (`app_events`' 30-day warn/error window, doc 05
//      §10) was already written to match on Windows, and diverging from it on Linux would mean
//      two different answers to "how far back can I look?" depending on platform. The journald
//      and Docker alternatives are recorded below in a comment rather than deleted outright, in
//      case a future Docker Compose path (doc 14 §11.11) needs them.
//   2. `prometheus.exporter.windows` → `prometheus.exporter.unix`. Different collector names,
//      and consequently different metric names in the dashboard's host panels
//      (`windows_cpu_time_total` → `node_cpu_seconds_total`, and so on). The dashboard's three
//      "Makine" panels will need their expressions changed; nothing above that row does.
//   3. Paths and the secret file's protection. `chmod 600` owned by the alloy user replaces the
//      Windows ACL, and forward slashes replace the doubled backslashes that Alloy string
//      literals require on Windows.
//
// Everything else — the JSON parsing, the timestamp handling, the label choices and above all
// the cardinality rules — is identical, and identically load-bearing. Read the Windows template's
// comments; they are not repeated here.
//
// Unlike the Windows file this one is NOT a rendered template: there is no installer on this
// path yet. It reads its settings from the environment, which under systemd means an
// `EnvironmentFile=` in the unit and under Docker means the usual `environment:` block.

local.file "grafana_token" {
  // Same rule as Windows: the token is never an environment variable and never inline. On Linux
  // that means a file owned by the alloy user with mode 0600 — `/proc/<pid>/environ` is readable
  // by the owning user, and process environment leaks into crash dumps and `ps` output on some
  // configurations.
  filename  = sys.env("BUYBOX_TOKEN_FILE")
  is_secret = true
}

// ---------------------------------------------------------------------------------------------
// Logs — file-based, matching the Windows config (decided 2026-09-08, see the header comment)
// ---------------------------------------------------------------------------------------------

local.file_match "buybox_logs" {
  path_targets = [
    {
      __path__ = sys.env("BUYBOX_DATA_DIR") + "/logs/buybox.out.log",
      stream   = "stdout",
    },
    {
      __path__ = sys.env("BUYBOX_DATA_DIR") + "/logs/buybox.err.log",
      stream   = "stderr",
    },
  ]
  sync_period = "30s"
}

loki.source.file "buybox_logs" {
  targets       = local.file_match.buybox_logs.targets
  forward_to    = [loki.process.buybox_logs.receiver]
  // Read existing files from the beginning on first start, so the install does not begin with
  // an artificial gap. Survives logrotate's copytruncate (installer/linux/buybox.logrotate):
  // Alloy follows the file by inode, and copytruncate keeps the same inode.
  tail_from_end = false
}

// ---------------------------------------------------------------------------------------------
// Logs — alternatives not currently wired up, kept for a future Docker Compose path (doc 14
// §11.11). If that path is ever built, delete the file-based blocks above and uncomment the one
// that applies instead of running both.
// ---------------------------------------------------------------------------------------------
//
// loki.source.journal "buybox" {
//   forward_to    = [loki.process.buybox_logs.receiver]
//   matches       = "_SYSTEMD_UNIT=buybox.service"
//   max_age       = "24h"
//   relabel_rules = discovery.relabel.journal.rules
// }
//
// discovery.relabel "journal" {
//   targets = []
//   rule {
//     source_labels = ["__journal_priority_keyword"]
//     target_label  = "stream"
//   }
// }
//
// discovery.docker "buybox" {
//   host = "unix:///var/run/docker.sock"
//   filter {
//     name   = "label"
//     values = ["com.docker.compose.service=buybox"]
//   }
// }
//
// loki.source.docker "buybox" {
//   host       = "unix:///var/run/docker.sock"
//   targets    = discovery.docker.buybox.targets
//   forward_to = [loki.process.buybox_logs.receiver]
// }

// ---------------------------------------------------------------------------------------------
// Log processing — identical to Windows
// ---------------------------------------------------------------------------------------------

loki.process "buybox_logs" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // The line is forwarded unchanged; there is no `stage.output`. See the Windows template.
  stage.json {
    expressions = {
      time  = "time",
      level = "level",
      name  = "name",
    }
  }

  stage.timestamp {
    source            = "time"
    format            = "RFC3339"
    action_on_failure = "fudge"
  }

  // ONLY these become labels. The cardinality rule is the same on every OS and is the single
  // most expensive mistake available in a Loki config.
  stage.labels {
    values = {
      level = "level",
      name  = "name",
    }
  }

  stage.static_labels {
    values = {
      job      = "buybox",
      instance = sys.env("BUYBOX_INSTANCE"),
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = local.file.grafana_token.content
    }
  }
}

// ---------------------------------------------------------------------------------------------
// Application metrics — identical to Windows apart from the address
// ---------------------------------------------------------------------------------------------

prometheus.scrape "buybox_app" {
  targets = [
    {
      __address__ = sys.env("BUYBOX_ADDRESS"),
      instance    = sys.env("BUYBOX_INSTANCE"),
    },
  ]
  metrics_path    = "/api/metrics"
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ---------------------------------------------------------------------------------------------
// Host metrics
// ---------------------------------------------------------------------------------------------

prometheus.exporter.unix "host" {
  // The Linux counterparts of the five Windows collectors, and the same reasoning: a deliberately
  // small set, because every collector is series volume against the free tier's limit.
  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo"]
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  // Same argument as on Windows: the exporter's targets carry their own `instance` label, which
  // would land host metrics under a different name than app metrics and break every panel
  // showing the two together. `external_labels` cannot fix it — they are only applied to series
  // that do not already carry the label.
  rule {
    target_label = "instance"
    replacement  = sys.env("BUYBOX_INSTANCE")
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = local.file.grafana_token.content
    }
  }
}
